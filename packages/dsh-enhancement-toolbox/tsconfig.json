{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": false,
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": false
  },
  "include": ["src", "tests"]
}
